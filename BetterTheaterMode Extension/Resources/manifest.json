{
  "manifest_version": 3,
  "name": "BetterTheaterMode",
  "short_name": "BetterTheaterMode",
  "version": "1.0.0",
  "description": "Makes the video fill the entire window when YouTube theater mode is active.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  },
  "action": {
    "default_title": "Toggle Theater Fill"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"]
}
